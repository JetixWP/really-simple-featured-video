{
  "name": "really-simple-featured-video",
  "version": "1.1.0",
  "description": "Really Simple Featured Video plugin provides a really straightforward way of adding featured video support to your custom post types. Adding your own videos to the site is a breeze and you get an easy to use settings panel with the options you really need.",
  "main": "index.js",
  "scripts": {
    "build": "npm run build:tools && npm run build:studio && npm run build:blocks",
    "build:tools": "wp-scripts build --webpack-src-dir=src/tools --output-path=assets/js/tools",
    "build:blocks": "wp-scripts build --webpack-src-dir=src/blocks --output-path=assets/blocks --webpack-copy-php",
    "build:studio": "wp-scripts build studio=./index.js studio-runtime=../studio-runtime/index.js --webpack-src-dir=src/studio --output-path=assets/js/studio",
    "start": "wp-scripts start --webpack-src-dir=src/tools --output-path=assets/js/tools",
    "start:blocks": "wp-scripts start --webpack-src-dir=src/blocks --output-path=assets/blocks --webpack-copy-php",
    "start:studio": "wp-scripts start studio=./index.js studio-runtime=../studio-runtime/index.js --webpack-src-dir=src/studio --output-path=assets/js/studio",
    "package": "composer install --no-dev && wp-scripts plugin-zip",
    "scripts-update": "wp-scripts packages-update",
    "translate": "wp i18n make-pot . ./languages/rsfv.pot"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JetixWP/really-simple-featured-video.git"
  },
  "author": "JetixWP",
  "license": "GPL-2.0-or-later",
  "bugs": {
    "url": "https://github.com/JetixWP/really-simple-featured-video/issues"
  },
  "homepage": "https://jetixwp.com/plugins/really-simple-featured-video",
  "devDependencies": {
    "@wordpress/scripts": "^30.13.0"
  },
  "dependencies": {
    "@wordpress/api-fetch": "^7.13.0",
    "@wordpress/components": "^29.0.0",
    "@wordpress/element": "^6.13.0",
    "@wordpress/i18n": "^5.13.0",
    "animejs": "^4.5.0",
    "mediabunny": "^1.60.0"
  },
  "files": [
    "freemius",
    "assets",
    "includes",
    "vendor",
    "languages",
    "readme.txt",
    "really-simple-featured-video.php"
  ]
}
